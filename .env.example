# Server Settings
PROJECT_NAME="FastAPI qBittorrent API"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
API_V1_STR="/api/v1"

# qBittorrent WebUI Connection
QBIT_HOST="127.0.0.1"
QBIT_PORT=8089
QBIT_USERNAME="admin"
QBIT_PASSWORD=""
QBIT_VERIFY_WEBUI_CERTIFICATE=false

# Default Download Path
DEFAULT_SAVE_PATH="/home/boxd/Downloads/"

# Prowlarr Search (optional defaults; can also be configured via API)
PROWLARR_URL=""
PROWLARR_API_KEY=""

# Telegram Bot (Pyrogram)
# Obtain TELEGRAM_BOT_TOKEN from @BotFather on Telegram
# Obtain TELEGRAM_API_ID and TELEGRAM_API_HASH from https://my.telegram.org
TELEGRAM_BOT_TOKEN=""
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Optional: Comma-separated user IDs (e.g. "12345678,98765432"). If left empty, bot is accessible to everyone.
TELEGRAM_AUTHORIZED_USERS=""


